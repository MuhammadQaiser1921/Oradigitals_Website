<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= page.title %></title>
  <meta name="description" content="<%= page.description %>" />
  <%
    const siteUrl = 'https://oradigitals.com'
    // Share picture: the page's own (case studies, products) or the branded default, all 1200 x 630
    const shareImage = siteUrl + (page.image || '/public/images/share/oradigitals.png')
    // JSON for <script> blocks; "<" is escaped so text can never close the script tag
    const jsonLd = (data) => JSON.stringify(data).replace(/</g, '\\u003c')
    const organization = {
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}/#organization`,
      name: site.legalName,
      alternateName: site.name,
      url: siteUrl,
      logo: `${siteUrl}/public/icons/icon-512.png`,
      image: `${siteUrl}/public/images/share/oradigitals.png`,
      description: site.tagline,
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address,
        addressLocality: 'Okara',
        addressRegion: 'Punjab',
        postalCode: '56300',
        addressCountry: 'PK',
      },
      telephone: site.phone,
      email: site.email,
      contactPoint: [site.phone, site.phone2].map((telephone) => ({
        '@type': 'ContactPoint',
        telephone,
        email: site.email,
        contactType: 'customer service',
      })),
      taxID: site.fbrNumber,
      sameAs: [site.mapLink, site.secpVerificationLink],
    }
  %>
  <% if (page.noindex) { %>
    <%# Error pages: keep them out of search results and don't claim a canonical address %>
    <meta name="robots" content="noindex" />
  <% } else { %>
    <link rel="canonical" href="<%= siteUrl + currentPath %>" />
  <% } %>

  <!-- OpenGraph / Social Media -->
  <meta property="og:type" content="<%= page.schema && page.schema['@type'] === 'Article' ? 'article' : 'website' %>" />
  <meta property="og:title" content="<%= page.title %>" />
  <meta property="og:description" content="<%= page.description %>" />
  <% if (!page.noindex) { %>
    <meta property="og:url" content="<%= siteUrl + currentPath %>" />
  <% } %>
  <meta property="og:site_name" content="OraDigitals" />
  <meta property="og:image" content="<%= shareImage %>" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="<%= page.title %>" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= page.title %>" />
  <meta name="twitter:description" content="<%= page.description %>" />
  <meta name="twitter:image" content="<%= shareImage %>" />

  <!-- Schema.org JSON-LD Structured Data -->
  <script type="application/ld+json"><%- jsonLd(organization) %></script>
  <% if (page.schema) { %>
    <script type="application/ld+json"><%- jsonLd(page.schema) %></script>
  <% } %>

  <!-- Google Fonts: Inter in the weights the stylesheet uses -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Favicons, phone home-screen icon & Stylesheet -->
  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/public/site.webmanifest" />
  <meta name="theme-color" content="#284763" />
  <link rel="stylesheet" href="/public/express.css?v=<%= cssVersion %>" />
</head>
<body>
  <header class="site-header">
    <div class="container nav-row">
      <a class="brand" href="/" aria-label="OraDigitals">
        <span class="brand-ora">ORA</span><span class="brand-digitals">DIGITALS</span>
      </a>

      <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Menu" aria-controls="navLinks" aria-expanded="false">
        <svg class="hamburger-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <%# Shown instead of the ☰ icon while the menu is open (see .mobile-nav-toggle in the stylesheet) %>
        <svg class="close-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>

      <nav class="nav-links" id="navLinks">
        <% /* Highlight the menu section the page sits under (from the page's breadcrumb trail, which is not shown) */ %>
        <% const activeSection = typeof breadcrumbs !== 'undefined' && breadcrumbs && breadcrumbs[1] ? breadcrumbs[1].href : '' %>
        <% site.nav.forEach((item, navIdx) => { %>
          <% if (item.isMega && item.groups) { %>
            <div class="nav-item-wrapper has-submenu has-mega">
              <a href="<%= item.href %>" class="nav-link <%= item.href === activeSection ? 'active' : '' %>"><%= item.label %></a>
              <button type="button" class="submenu-toggle" aria-expanded="false" aria-controls="nav-menu-<%= navIdx %>" aria-label="<%= item.label %> menu">
                <svg class="nav-arrow" viewBox="0 0 512 512" width="11" height="11" fill="currentColor" aria-hidden="true">
                  <path d="M256 294.1L383 167c9.4-9.4 24.6-9.4 33.9 0s9.3 24.6 0 34L273 345c-9.1 9.1-23.7 9.3-33.1.7L95 201.1c-4.7-4.7-7-10.9-7-17s2.3-12.3 7-17c9.4-9.4 24.6-9.4 33.9 0l127.1 127z"></path>
                </svg>
              </button>
              <div class="mega-menu" id="nav-menu-<%= navIdx %>">
                <div class="mega-grid">
                  <% item.groups.forEach((grp) => { %>
                    <div class="mega-col">
                      <h5><%= grp.heading %></h5>
                      <% grp.items.forEach((sub) => { %>
                        <a href="<%= sub.href %>" class="mega-item">
                          <span class="mega-item-title"><%= sub.label %></span>
                          <span class="mega-item-desc"><%= sub.desc %></span>
                        </a>
                      <% }) %>
                    </div>
                  <% }) %>
                </div>
              </div>
            </div>
          <% } else if (item.submenu && item.submenu.length > 0) { %>
            <div class="nav-item-wrapper has-submenu">
              <a href="<%= item.href %>" class="nav-link <%= item.href === activeSection ? 'active' : '' %>"><%= item.label %></a>
              <button type="button" class="submenu-toggle" aria-expanded="false" aria-controls="nav-menu-<%= navIdx %>" aria-label="<%= item.label %> menu">
                <svg class="nav-arrow" viewBox="0 0 512 512" width="11" height="11" fill="currentColor" aria-hidden="true">
                  <path d="M256 294.1L383 167c9.4-9.4 24.6-9.4 33.9 0s9.3 24.6 0 34L273 345c-9.1 9.1-23.7 9.3-33.1.7L95 201.1c-4.7-4.7-7-10.9-7-17s2.3-12.3 7-17c9.4-9.4 24.6-9.4 33.9 0l127.1 127z"></path>
                </svg>
              </button>
              <div class="submenu" id="nav-menu-<%= navIdx %>">
                <% item.submenu.forEach((subitem) => { %>
                  <a href="<%= subitem.href %>" class="submenu-link">
                    <span class="submenu-item-title"><%= subitem.label %></span>
                    <% if (subitem.desc) { %>
                      <span class="submenu-item-desc"><%= subitem.desc %></span>
                    <% } %>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } else { %>
            <div class="nav-item-wrapper">
              <a href="<%= item.href %>" class="nav-link <%= item.href === activeSection ? 'active' : '' %>"><%= item.label %></a>
            </div>
          <% } %>
        <% }) %>
        <%# On phones the header buttons don't fit, so they sit at the bottom of the ☰ menu instead %>
        <div class="nav-menu-actions">
          <%- include('partials/header-buttons') %>
        </div>
      </nav>

      <div class="header-actions">
        <%- include('partials/header-buttons') %>
      </div>
    </div>
  </header>

  <main>
    <%# Form results appear inside the form itself; this is for other messages, e.g. on the error page %>
    <% if (flash && flash.message && !page.sections.some((section) => section.component === 'contact-form')) { %>
      <section class="section" style="padding-bottom: 0;">
        <div class="container">
          <div class="flash <%= flash.status === 'success' ? 'flash-success' : 'flash-info' %>">
            <p><%= flash.message %></p>
          </div>
        </div>
      </section>
    <% } %>

    <%
      // Sections alternate white / grey like the landing page, starting with white; the case-study article is
      // always grey, so the section after it is white.
      let nextLight = true
      // The landing hero and the case-study article carry their own H1; on every other page the first
      // section's heading is promoted to the page's H1.
      let hasH1 = page.sections.some((section) => ['hero', 'case-study-single'].includes(section.component))
    %>
    <% page.sections.forEach((section) => { %>
      <%
        let props = section.props
        if (section.component === 'hero' || section.component === 'case-study-single') {
          nextLight = true
        } else {
          props = { ...section.props, light: nextLight }
          nextLight = !nextLight
          if (!hasH1) {
            props.headingTag = 'h1'
            hasH1 = true
          }
        }
      %>
      <%- include('components/' + section.component, { props, site, currentPath, flash }) %>
    <% }) %>
  </main>

