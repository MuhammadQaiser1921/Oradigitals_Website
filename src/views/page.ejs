  <!-- Scripts: Mobile Navigation & Menu Interactions -->
  <script>
    (function() {
      // 1. Mobile Menu Toggle (the stylesheet swaps the ☰ and × icons from aria-expanded)
      var toggle = document.getElementById('mobileNavToggle');
      var navLinks = document.getElementById('navLinks');
      if (toggle && navLinks) {
        toggle.addEventListener('click', function() {
          var isOpen = navLinks.classList.toggle('open');
          toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
      }

      // 2. Sub-menu toggles: the arrow button opens a menu on tap, click or keyboard (one open at a time)
      var subWrappers = document.querySelectorAll('.nav-item-wrapper.has-submenu');
      var hoverMenus = window.matchMedia('(hover: hover) and (min-width: 1101px)');
      function closeSubmenus(except) {
        subWrappers.forEach(function(wrapper) {
          if (wrapper === except) return;
          wrapper.classList.remove('open');
          var button = wrapper.querySelector('.submenu-toggle');
          if (button) button.setAttribute('aria-expanded', 'false');
        });
      }
      subWrappers.forEach(function(wrapper) {
        var button = wrapper.querySelector('.submenu-toggle');
        if (!button) return;
        button.addEventListener('click', function(e) {
          e.stopPropagation();
          var isOpen = wrapper.classList.toggle('open');
          button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          if (isOpen) {
            closeSubmenus(wrapper);
            // Closing a long menu above can push this one out of view in the mobile list
            wrapper.scrollIntoView({ block: 'nearest' });
          }
        });
        // Desktop only: hovering another item closes a menu opened by click. Phones fire a
        // synthetic mouseenter on tap, and collapsing menus there would shift the tap target.
        wrapper.addEventListener('mouseenter', function() {
          if (hoverMenus.matches) closeSubmenus(wrapper);
        });
      });
      document.addEventListener('click', function(e) {
        if (!e.target.closest('.nav-item-wrapper.has-submenu')) closeSubmenus(null);
      });
      document.addEventListener('keydown', function(e) {
        if (e.key !== 'Escape') return;
        var openWrapper = document.querySelector('.nav-item-wrapper.has-submenu.open');
        if (!openWrapper) return;
        closeSubmenus(null);
        openWrapper.querySelector('.submenu-toggle').focus();
      });

      // 3. Mega-Menu Smooth Hover (desktop pointer only; CSS ignores show-mega elsewhere)
      var megaWrappers = document.querySelectorAll('.nav-item-wrapper.has-mega');
      megaWrappers.forEach(function(item) {
        var menu = item.querySelector('.mega-menu');
        if (!menu) return;
        var timeout = null;
        item.addEventListener('mouseenter', function() {
          if (timeout) clearTimeout(timeout);
          menu.classList.add('show-mega');
        });
        item.addEventListener('mouseleave', function() {
          timeout = setTimeout(function() {
            menu.classList.remove('show-mega');
          }, 150);
        });
        if (window.location.search.indexOf('test_mega=1') !== -1) {
          menu.classList.add('show-mega');
        }
      });

      // 4. Card carousels: arrows page through the cards, dim at either end, and hide when everything fits
      document.querySelectorAll('[data-carousel]').forEach(function(carousel) {
        var track = carousel.querySelector('[data-carousel-track]');
        var prev = carousel.querySelector('[data-carousel-prev]');
        var next = carousel.querySelector('[data-carousel-next]');
        if (!track || !prev || !next) return;
        function update() {
          var overflow = track.scrollWidth - track.clientWidth;
          prev.hidden = next.hidden = overflow <= 2;
          prev.disabled = track.scrollLeft <= 2;
          next.disabled = track.scrollLeft >= overflow - 2;
        }
        prev.addEventListener('click', function() {
          track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' });
        });
        next.addEventListener('click', function() {
          track.scrollBy({ left: track.clientWidth, behavior: 'smooth' });
        });
        track.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      });

      // 5. Forms: messages under each field, a "Sending…" state that blocks double submits, and the
      // result shown in the form without leaving the page. Without JavaScript the form posts normally.
      document.querySelectorAll('[data-api-form]').forEach(function(form) {
        var status = form.querySelector('[data-form-status]');
        var button = form.querySelector('button[type="submit"]');
        form.noValidate = true;

        function showStatus(kind, text) {
          status.hidden = false;
          status.className = 'form-status form-status-' + kind;
          status.textContent = text;
        }
        function setFieldError(field, text) {
          var error = document.getElementById(field.id + '-error');
          if (text) field.setAttribute('aria-invalid', 'true');
          else field.removeAttribute('aria-invalid');
          if (error) {
            error.textContent = text || '';
            error.hidden = !text;
          }
        }

        form.addEventListener('input', function(e) {
          if (e.target.getAttribute('aria-invalid') === 'true' && e.target.checkValidity()) setFieldError(e.target, '');
        });

        form.addEventListener('submit', function(e) {
          e.preventDefault();
          if (form.getAttribute('data-sending')) return;

          var invalid = [];
          Array.prototype.forEach.call(form.elements, function(field) {
            if (!field.id || !field.willValidate) return;
            var valid = field.checkValidity();
            setFieldError(field, valid ? '' : field.validationMessage);
            if (!valid) invalid.push(field);
          });
          if (invalid.length) {
            showStatus('error', 'Please correct the highlighted fields.');
            invalid[0].focus();
            return;
          }

          form.setAttribute('data-sending', 'true');
          button.disabled = true;
          button.textContent = 'Sending…';
          fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(new FormData(form)),
          })
            .then(function(res) {
              return res.json().then(function(data) { return { ok: res.ok, data: data }; });
            })
            .then(function(result) {
              var errors = result.data.errors || {};
              Object.keys(errors).forEach(function(name) {
                if (form.elements[name]) setFieldError(form.elements[name], errors[name]);
              });
              showStatus(result.ok ? 'success' : 'error', result.data.message);
              if (result.ok) form.reset();
            })
            .catch(function() {
              showStatus('error', 'Your message could not be sent. Please check your connection and try again.');
            })
            .then(function() {
              form.removeAttribute('data-sending');
              button.disabled = false;
              button.textContent = button.getAttribute('data-label');
              status.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            });
        });
      });
    })();
  </script>
</body>
</html>
