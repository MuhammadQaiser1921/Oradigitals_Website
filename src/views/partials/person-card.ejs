<%# Person card: photo (or initials until a photo is added), name, role, optional bio, email and phone %>
<%
  const nameParts = member.name.trim().split(/\s+/)
  const initials = (nameParts[0][0] + (nameParts.length > 1 ? nameParts[nameParts.length - 1][0] : '')).toUpperCase()
%>
<article class="card team-card">
  <% if (member.image) { %>
    <img src="<%= member.image %>" alt="<%= member.name %>, <%= member.role %>" class="team-avatar" loading="lazy" />
  <% } else { %>
    <span class="team-avatar team-initials" aria-hidden="true"><%= initials %></span>
  <% } %>
  <h3><%= member.name %></h3>
  <p class="card-subtitle"><%= member.role %></p>
  <% if (member.bio) { %>
    <p class="card-text"><%= member.bio %></p>
  <% } %>
  <% if (member.email || member.phone) { %>
    <div class="person-contact">
      <% if (member.email) { %>
        <a href="mailto:<%= member.email %>">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-10 6L2 7"></path>
          </svg>
          <span><%= member.email %></span>
        </a>
      <% } %>
      <% if (member.phone) { %>
        <a href="tel:<%= member.phone.replace(/\s+/g, '') %>">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span><%= member.phone %></span>
        </a>
      <% } %>
    </div>
  <% } %>
</article>
