<section class="section <%= props.light ? 'light' : '' %> testimonials-section" id="<%= props.id || 'testimonials' %>">
  <div class="container">
    <%- include('../partials/section-header', { props }) %>
    <div class="cards-grid cols-<%= props.columns || 2 %>">
      <% (props.items || []).forEach((item) => { %>
        <article class="card testimonial">
          <% if (item.rating) { %>
            <p class="rating"><%= '★'.repeat(item.rating) %></p>
          <% } %>
          <p class="quote">"<%= item.quote %>"</p>
          <h3><%= item.author %></h3>
          <p class="card-subtitle"><%= item.role %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>
