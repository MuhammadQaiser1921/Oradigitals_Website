<section class="section testimonials-section" id="<%= props.id || 'testimonials' %>">
  <div class="container">
    <%- include('../partials/section-header', { props }) %>
    <%# One row of up to three reviews %>
    <div class="cards-grid cols-<%= props.columns || Math.min(Math.max((props.items || []).length, 2), 3) %>">
      <% (props.items || []).forEach((item) => { %>
        <article class="card testimonial">
          <% if (item.rating) { %>
            <p class="rating" role="img" aria-label="Rated <%= item.rating %> out of 5"><%= '★'.repeat(item.rating) %></p>
          <% } %>
          <p class="quote">"<%= item.quote %>"</p>
          <h3><%= item.author %></h3>
          <p class="card-subtitle"><%= item.role %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>
