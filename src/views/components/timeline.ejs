<section class="section">
  <div class="container">
    <%- include('../partials/section-header', { props }) %>
    <div class="timeline">
      <% (props.items || []).forEach((item) => { %>
        <article class="timeline-item">
          <p class="timeline-year"><%= item.year %></p>
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>
