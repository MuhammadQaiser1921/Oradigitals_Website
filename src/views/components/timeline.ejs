<section class="section light">
  <div class="container">
    <% if (props.title) { %>
      <h2><%= props.title %></h2>
    <% } %>
    <div class="timeline">
      <% (props.items || []).forEach((item) => { %>
        <article class="timeline-item">
          <p class="timeline-year"><%= item.year %></p>
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>
