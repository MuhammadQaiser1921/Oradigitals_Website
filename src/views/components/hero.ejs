<%# Only the landing page has a hero; it uses the dark, centered style unless props say dark: false / centered: false %>
<%
  const isCentered = props.centered !== false
  const isDark = props.dark !== false
%>
<section class="hero <%= isDark ? 'hero-dark' : '' %> <%= props.compact ? 'hero-compact' : '' %> <%= isCentered ? 'hero-centered' : '' %>">
  <div class="hero-container <%= isCentered ? 'hero-container-centered' : '' %>">
    <div class="hero-content <%= isCentered ? 'hero-content-centered' : '' %>">
      <% if (props.badge) { %>
        <span class="badge"><%= props.badge %></span>
      <% } %>

      <h1 class="hero-heading">
        <% if (props.heading) { %>
          <span><%= props.heading %></span>
        <% } else if (props.headingBlue) { %>
          <span class="hero-heading-top"><%= props.headingBlue %></span>
          <% if (props.headingHighlight) { %>
            <span class="hero-highlight-row">
              <span class="hero-highlight-text">
                <svg aria-hidden="true" viewBox="0 0 418 42" class="hero-marker-svg" fill="currentColor" preserveAspectRatio="none">
                  <path d="M203.371.916c-26.013-2.078-76.686 1.963-124.73 9.946L67.3 12.749C35.421 18.062 18.2 21.766 6.004 25.934 1.244 27.561.828 27.778.874 28.61c.07 1.214.828 1.121 9.595-1.176 9.072-2.377 17.15-3.92 39.246-7.496C123.565 7.986 157.869 4.492 195.942 5.046c7.461.108 19.25 1.696 19.17 2.582-.107 1.183-7.874 4.31-25.75 10.366-21.992 7.45-35.43 12.534-36.701 13.884-2.173 2.308-.202 4.407 4.442 4.734 2.654.187 3.263.157 15.593-.78 35.401-2.686 57.944-3.488 88.365-3.143 46.327.526 75.721 2.23 130.788 7.584 19.787 1.924 20.814 1.98 24.557 1.332l.066-.011c1.201-.203 1.53-1.825.399-2.335-2.911-1.31-4.893-1.604-22.048-3.261-57.509-5.556-87.871-7.36-132.059-7.842-23.239-.254-33.617-.116-50.627.674-11.629.54-42.371 2.494-46.696 2.967-2.359.259 8.133-3.625 26.504-9.81 23.239-7.825 27.934-10.149 28.304-14.005.417-4.348-3.529-6-16.878-7.066Z"></path>
                </svg>
                <span class="highlight-word"><%= props.headingHighlight %></span>
              </span>
              <% if (props.headingBlack) { %>
                <span class="hero-heading-after"><%= props.headingBlack %></span>
              <% } %>
            </span>
          <% } else if (props.headingBlack) { %>
            <span class="hero-heading-bottom"><%= props.headingBlack %></span>
          <% } %>
        <% } else if (props.heading) { %>
          <span class="hero-heading-bottom"><%= props.heading %></span>
        <% } else { %>
          <span class="hero-heading-top">Put your business operations</span>
          <span class="hero-highlight-row">
            <span class="hero-highlight-text">
              <svg aria-hidden="true" viewBox="0 0 418 42" class="hero-marker-svg" fill="currentColor" preserveAspectRatio="none">
                <path d="M203.371.916c-26.013-2.078-76.686 1.963-124.73 9.946L67.3 12.749C35.421 18.062 18.2 21.766 6.004 25.934 1.244 27.561.828 27.778.874 28.61c.07 1.214.828 1.121 9.595-1.176 9.072-2.377 17.15-3.92 39.246-7.496C123.565 7.986 157.869 4.492 195.942 5.046c7.461.108 19.25 1.696 19.17 2.582-.107 1.183-7.874 4.31-25.75 10.366-21.992 7.45-35.43 12.534-36.701 13.884-2.173 2.308-.202 4.407 4.442 4.734 2.654.187 3.263.157 15.593-.78 35.401-2.686 57.944-3.488 88.365-3.143 46.327.526 75.721 2.23 130.788 7.584 19.787 1.924 20.814 1.98 24.557 1.332l.066-.011c1.201-.203 1.53-1.825.399-2.335-2.911-1.31-4.893-1.604-22.048-3.261-57.509-5.556-87.871-7.36-132.059-7.842-23.239-.254-33.617-.116-50.627.674-11.629.54-42.371 2.494-46.696 2.967-2.359.259 8.133-3.625 26.504-9.81 23.239-7.825 27.934-10.149 28.304-14.005.417-4.348-3.529-6-16.878-7.066Z"></path>
              </svg>
              <span class="highlight-word">future-proof</span>
            </span>
            <span class="hero-heading-after">autopilot,</span>
          </span>
        <% } %>
      </h1>

      <% if (props.subheading) { %>
        <p class="hero-subheading"><%= props.subheading %></p>
      <% } %>
      <% if (props.text) { %>
        <p class="hero-text"><%= props.text %></p>
      <% } %>
      <% if (props.highlights && props.highlights.length) { %>
        <ul class="hero-highlights">
          <% props.highlights.forEach((h) => { %>
            <li><span class="check-icon">&#10003;</span> <%= h %></li>
          <% }) %>
        </ul>
      <% } %>

      <!-- Flick Buttons Layout: Primary Solid + Outline with Arrow Icon -->
      <% if (props.actions && props.actions.length) { %>
        <div class="actions hero-actions">
          <% props.actions.forEach((action) => { %>
            <% const actionHref = action.href; %>
            <% if (action.style === 'outline') { %>
              <a class="btn btn-outline" href="<%= actionHref %>">
                <span><%= action.label %></span>
                <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" width="15" height="15">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </a>
            <% } else { %>
              <a class="btn btn-primary" href="<%= actionHref %>"><%= action.label %></a>
            <% } %>
          <% }) %>
        </div>
      <% } %>
    </div>

    <% if (!isCentered) { %>
    <div class="hero-visual">
      <% if (props.showOrbit) { %>
        <div class="orbit-container">
          <div class="orbit-center">
            <div class="orbit-logo-pulse" title="OraDigitals">
              <svg viewBox="0 0 36 36" width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="18" cy="18" r="13" stroke="#ffffff" stroke-width="2.75"/>
                <circle cx="25" cy="11" r="3.75" fill="#f09b4a"/>
              </svg>
              <span class="orbit-brand-text"><span style="color: #f09b4a;">ORA</span></span>
            </div>
          </div>
          <div class="orbit-ring ring-1">
            <div class="orbit-node node-oracle" title="Oracle ERP Fusion & EBS">
              <%- include('../partials/svg-icon', { iconName: 'database', iconClass: 'node-svg' }) %>
              <span>Oracle ERP</span>
            </div>
            <div class="orbit-node node-zatca" title="Saudi ZATCA Fatoora">
              <%- include('../partials/svg-icon', { iconName: 'shield', iconClass: 'node-svg' }) %>
              <span>ZATCA KSA</span>
            </div>
          </div>
          <div class="orbit-ring ring-2">
            <div class="orbit-node node-fbr" title="Pakistan FBR e-Invoicing">
              <%- include('../partials/svg-icon', { iconName: 'government', iconClass: 'node-svg' }) %>
              <span>FBR Tax</span>
            </div>
            <div class="orbit-node node-fta" title="Dubai UAE FTA Tax">
              <%- include('../partials/svg-icon', { iconName: 'building', iconClass: 'node-svg' }) %>
              <span>Dubai FTA</span>
            </div>
          </div>
          <div class="orbit-ring ring-3">
            <div class="orbit-node node-shopify" title="Shopify Plus & Apps">
              <%- include('../partials/svg-icon', { iconName: 'shopping', iconClass: 'node-svg' }) %>
              <span>Shopify</span>
            </div>
            <div class="orbit-node node-banks" title="Corporate Bank APIs">
              <%- include('../partials/svg-icon', { iconName: 'bank', iconClass: 'node-svg' }) %>
              <span>Bank APIs</span>
            </div>
            <div class="orbit-node node-courier" title="Courier Integrations">
              <%- include('../partials/svg-icon', { iconName: 'truck', iconClass: 'node-svg' }) %>
              <span>Couriers</span>
            </div>
          </div>
        </div>
      <% } else if (props.illustration || props.image) { %>
        <div class="hero-illustration-card">
          <img src="<%= props.illustration || props.image %>" alt="<%= props.heading || 'OraDigitals Enterprise Cloud, ERP & API Architecture' %>" class="hero-illustration-img" loading="eager" />
        </div>
      <% } else { %>
        <svg class="hero-lines" viewBox="0 0 400 600" preserveAspectRatio="none">
          <line class="animated-line line-1" x1="20" y1="50" x2="380" y2="550" />
          <line class="animated-line line-2" x1="80" y1="20" x2="380" y2="600" />
          <line class="animated-line line-3" x1="140" y1="0" x2="340" y2="600" />
          <line class="animated-line line-4" x1="200" y1="0" x2="300" y2="600" />
          <line class="animated-line line-5" x1="260" y1="20" x2="280" y2="600" />
        </svg>
      <% } %>
    </div>
    <% } %>
  </div>
</section>
