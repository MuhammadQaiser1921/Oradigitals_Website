<%# Landing page hero: dark, centered headline with actions, an optional row of figures and the wave into the
    first section. Inner pages use page-hero instead. %>
<%
  const isCentered = props.centered !== false
  const isDark = props.dark !== false
%>
<section class="hero <%= isDark ? 'hero-dark' : '' %> <%= props.compact ? 'hero-compact' : '' %> <%= isCentered ? 'hero-centered' : '' %> <%= props.stats ? 'hero-with-stats' : '' %>">
  <div class="hero-container <%= isCentered ? 'hero-container-centered' : '' %>">
    <div class="hero-content <%= isCentered ? 'hero-content-centered' : '' %>">
      <% if (props.badge) { %>
        <span class="badge"><%= props.badge %></span>
      <% } %>

      <h1 class="hero-heading"><span><%= props.heading %></span></h1>

      <% if (props.subheading) { %>
        <p class="hero-subheading"><%= props.subheading %></p>
      <% } %>
      <% if (props.text) { %>
        <p class="hero-text"><%= props.text %></p>
      <% } %>

      <% if (props.actions && props.actions.length) { %>
        <div class="actions hero-actions">
          <% props.actions.forEach((action) => { %>
            <% if (action.style === 'outline') { %>
              <a class="btn btn-outline" href="<%= action.href %>">
                <span><%= action.label %></span>
                <%- include('../partials/svg-icon', { iconName: 'arrow-up-right', iconClass: 'btn-icon' }) %>
              </a>
            <% } else { %>
              <a class="btn btn-primary" href="<%= action.href %>"><%= action.label %></a>
            <% } %>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <% if (props.stats && props.stats.length) { %>
    <ul class="hero-stats">
      <% props.stats.forEach((stat) => { %>
        <li class="hero-stat">
          <strong class="hero-stat-value"><%= stat.value %></strong>
          <span class="hero-stat-label"><%= stat.label %></span>
        </li>
      <% }) %>
    </ul>
    <%# Wave into the grey first section %>
    <svg class="hero-wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 78C180 112 360 122 540 102C700 84 820 24 1000 12C1140 3 1240 58 1340 62C1390 64 1420 54 1440 46V120H0Z" fill="#f3f6f5" />
    </svg>
  <% } %>
</section>
