<section class="section <%= props.light ? 'light' : '' %>">
  <div class="container">
    <%- include('../partials/section-header', { props }) %>
    <div class="cards-grid cols-3">
      <% (props.items || []).forEach((item) => { %>
        <article class="card gallery-card">
          <p class="chip"><%= item.category %></p>
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>
