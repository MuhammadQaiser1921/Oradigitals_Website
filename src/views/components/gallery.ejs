<section class="section <%= props.light ? 'light' : '' %>">
  <div class="container">
    <%- include('../partials/section-header', { props }) %>
    <% if (props.image) { %>
      <img class="gallery-photo" src="<%= props.image %>" alt="<%= props.imageAlt || '' %>" width="1600" height="422" loading="lazy" />
    <% } %>
    <div class="cards-grid cols-<%= props.columns || 3 %>">
      <% (props.items || []).forEach((item) => { %>
        <article class="card gallery-card">
          <% if (item.image) { %>
            <img class="gallery-card-image" src="<%= item.image %>" alt="<%= item.imageAlt || '' %>" width="900" height="600" loading="lazy" />
          <% } %>
          <p class="chip"><%= item.category %></p>
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>
