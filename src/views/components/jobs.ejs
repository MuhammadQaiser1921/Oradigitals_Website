<section class="section" id="<%= props.id || 'openings' %>">
  <div class="container">
    <%- include('../partials/section-header', { props }) %>
    <div class="jobs-grid">
      <% (props.items || []).forEach((job) => { %>
        <article class="card job-card">
          <h3><%= job.title %></h3>
          <p class="card-subtitle"><%= job.department %> | <%= job.location %> | <%= job.type %></p>
          <p><%= job.description %></p>
          <% if (Array.isArray(job.requirements) && job.requirements.length) { %>
            <h4>Requirements</h4>
            <ul class="card-list">
              <% job.requirements.forEach((req) => { %>
                <li><%= req %></li>
              <% }) %>
            </ul>
          <% } %>
        </article>
      <% }) %>
    </div>
  </div>
</section>
