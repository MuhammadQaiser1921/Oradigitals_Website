<section class="section <%= props.light ? 'light' : '' %>" id="<%= props.id || '' %>">
  <div class="container">
    <%- include('../partials/section-header', { props }) %>
    <%# compact: small cards (icon, title, short text, "Explore" link); a featured card spans two columns and rows %>
    <div class="cards-grid cols-<%= props.columns || 3 %> <%= props.compact ? 'cards-compact' : '' %>">
      <% props.cards.forEach((card) => { %>
        <% const featured = props.compact && card.featured %>
        <article class="card <%= card.highlight ? 'card-highlight' : '' %> <%= featured ? 'card-featured' : '' %>"<% if (card.id) { %> id="<%= card.id %>"<% } %>>
          <% if (card.icon) { %>
            <div class="card-icon-wrap">
              <%- include('../partials/svg-icon', { iconName: card.icon, iconClass: 'card-svg' }) %>
            </div>
          <% } %>
          <h3><%= card.title %></h3>
          <% if (card.subtitle && (!props.compact || featured)) { %>
            <p class="card-subtitle"><%= card.subtitle %></p>
          <% } %>
          <p class="card-text"><%= props.compact && !featured && card.short ? card.short : card.text %></p>
          <% if (featured && card.tags) { %>
            <ul class="card-tags">
              <% card.tags.forEach((tag) => { %><li><%= tag %></li><% }) %>
            </ul>
          <% } %>
          <% if (Array.isArray(card.list) && card.list.length) { %>
            <% const hasLinkItems = card.list.some(item => typeof item === 'object' || (typeof item === 'string' && (item.includes(': /') || item.startsWith('/')))); %>
            <ul class="card-list <%= hasLinkItems ? 'has-links' : '' %>">
              <% card.list.forEach((item) => { %>
                <%
                  let itemLabel = item;
                  let itemHref = null;
                  if (typeof item === 'object' && item !== null) {
                    itemLabel = item.label || item.title || '';
                    itemHref = item.href || item.url || null;
                  } else if (typeof item === 'string') {
                    const colonIdx = item.lastIndexOf(': /');
                    if (colonIdx !== -1) {
                      itemLabel = item.slice(0, colonIdx).trim();
                      itemHref = item.slice(colonIdx + 2).trim();
                    } else if (item.startsWith('/')) {
                      itemLabel = item;
                      itemHref = item;
                    }
                  }
                %>
                <% if (itemHref) { %>
                  <li class="card-list-item-link">
                    <a href="<%= itemHref %>" class="sitemap-link">
                      <span><%= itemLabel %></span>
                      <svg class="sitemap-link-arrow" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </a>
                  </li>
                <% } else { %>
                  <li><%= item %></li>
                <% } %>
              <% }) %>
            </ul>
          <% } %>
          <% if (card.link && card.link.href && card.link.label) { %>
            <% const finalCardHref = card.link.href; %>
            <div class="card-action-wrap">
              <a
                class="card-btn <%= props.compact ? 'card-explore' : '' %>"
                href="<%= finalCardHref %>"
                <%= card.link.href.startsWith('http') ? 'target="_blank" rel="noopener noreferrer"' : '' %>
                <% if (props.compact) { %>aria-label="Explore <%= card.title %>"<% } %>
              >
                <span><%= props.compact ? 'Explore' : card.link.label %></span>
                <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          <% } %>
        </article>
      <% }) %>
    </div>

    <% 
      const footerLinkObj = props.footerLink || (props.ctaHref ? { href: props.ctaHref, label: props.ctaLabel || 'Explore our services' } : null);
    %>
    <% if (footerLinkObj && footerLinkObj.href && footerLinkObj.label) { %>
      <% const sectionFooterLink = footerLinkObj.href; %>
      <div class="cards-footer-link">
        <a href="<%= sectionFooterLink %>" class="cards-cta-link">
          <span><%= footerLinkObj.label %></span>
          <svg class="cards-arrow-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    <% } %>
  </div>
</section>
